# Reference only: Streamlit does NOT automatically load this file or .env.
# Set these variables in the server's launch environment, or use the sidebar
# for per-browser-session generation settings. Never commit real credentials.

# Server inference device; restart the server after changing it.
# Set cuda:0 only with a working CUDA-enabled PyTorch installation.
FINANCE_QA_DEVICE=cpu

# Corpus version (report_search.demo_service.CORPORA): v2 (default, built by scripts/build_corpus.py)
# or v1, the corpus behind Tables A1-A13. Restart the server after changing it.
FINANCE_QA_CORPUS=v2

# OpenAI-compatible API base. The client appends /chat/completions.
# Remote endpoints require HTTPS; loopback HTTP is allowed for local servers.
FINANCE_QA_BASE_URL=
FINANCE_QA_MODEL=
FINANCE_QA_API_KEY=

# Optional reviewer model on the same endpoint; blank reuses the generator model.
FINANCE_QA_VERIFIER_MODEL=

# Select max_tokens instead if required by the configured endpoint.
FINANCE_QA_TOKEN_PARAMETER=max_completion_tokens

# Explicit finite raw reranker cutoff. Blank means refusal-only generation.
# No diagnostic threshold is installed as a production default.
FINANCE_QA_THRESHOLD=

# Cooperative generation-layer budget; excludes retrieval and cannot interrupt
# an active synchronous API call. Must be finite and positive.
FINANCE_QA_DEADLINE_SECONDS=30
